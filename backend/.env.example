# Application Settings
PROJECT_NAME="PhysioVerse Backend SaaS"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True
JWT_SECRET="super-secret-key-change-this-in-production-physioverse-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM="HS256"

# MongoDB Atlas Settings
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=<cluster-name>"
DATABASE_NAME="physioverse"

# Redis Settings
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0

# Razorpay Settings
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# AWS S3 Storage
AWS_ACCESS_KEY_ID="your_aws_access_key"
AWS_SECRET_ACCESS_KEY="your_aws_secret_key"
AWS_REGION="us-east-1"
S3_BUCKET_NAME="physioverse-media-bucket"

# Cloudinary Storage (Alternative)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# SMTP Email Settings
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USERNAME="notifications@physioverse.app"
EMAIL_PASSWORD="your-app-password"
FROM_EMAIL="notifications@physioverse.app"

# CORS Origins (Comma separated)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://localhost:5000","*"]
